PORT=3000

# Required: API key that downstream apps must send in the x-api-key header to POST /send
GATEWAY_API_KEY=your_super_secret_api_key_here

# Required: Google Gemini API key for AI intent classification
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Comma-separated ADMIN numbers (no + prefix). Only these bypass user
# checks and can run admin commands (/generate-key, /users, /revoke, /extend).
# Regular users are onboarded via beta keys instead. Example: 919876543210
ALLOWED_NUMBERS=

# Required: Railway PostgreSQL connection string (from the Postgres addon)
DATABASE_URL=postgres://user:pass@host:5432/db

# Required: Comma-separated invite codes. Each grants access to all services.
# A user activates by sending the code as their FIRST message.
BETA_KEYS=ALPHA1,BETA2
# Optional: how long a trial lasts after activation, in hours.
TRIAL_DURATION_HOURS=24

# Per-app webhook secrets — sent as x-gateway-secret header to each app's webhook.
# Set these in the environment and substitute them into config.json before deploy.
# Generate a unique value per app: openssl rand -hex 32
LIAW_WEBHOOK_SECRET=your_liaw_webhook_secret_here
LIAW_WEBHOOK_URL=""

# Downstream app: keep (notes/links/bookmarks)
# Generate a unique value per app: openssl rand -hex 32
NOTES_WEBHOOK_SECRET=your_notes_webhook_secret_here
NOTES_WEBHOOK_URL=""

# Optional tuning
SESSION_TTL_MINUTES=5
WEBHOOK_TIMEOUT_MS=10000
AI_CONFIDENCE_THRESHOLD=0.6
