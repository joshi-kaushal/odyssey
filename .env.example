PORT=3000

# Required: API key that downstream apps must send in the x-api-key header to POST /send
GATEWAY_API_KEY=your_super_secret_api_key_here

# Required: Google Gemini API key for AI intent classification
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Comma-separated whitelist of allowed inbound numbers (no + prefix)
# Example: 919876543210,919123456789
ALLOWED_NUMBERS=

# Per-app webhook secrets — sent as x-gateway-secret header to each app's webhook.
# Set these in the environment and substitute them into config.json before deploy.
# Generate a unique value per app: openssl rand -hex 32
LIAW_WEBHOOK_SECRET=your_liaw_webhook_secret_here

# Optional tuning
SESSION_TTL_MINUTES=5
WEBHOOK_TIMEOUT_MS=10000
AI_CONFIDENCE_THRESHOLD=0.6
