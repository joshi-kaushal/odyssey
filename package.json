{
  "name": "odyssey-gateway",
  "version": "2.0.0",
  "description": "Central WhatsApp Gateway using Baileys",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prestart": "drizzle-kit migrate",
    "dev": "nodemon --exec ts-node src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@langchain/core": "^0.3.17",
    "@langchain/google-genai": "^0.1.3",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "pg": "^8.23.0",
    "pino": "^8.16.2",
    "qrcode-terminal": "^0.12.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
